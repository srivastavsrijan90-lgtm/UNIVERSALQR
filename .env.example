# UniversalQR Configuration Environment Variables

# Flask Secret Key (change to a random string in production)
FLASK_SECRET_KEY=uqr-change-this-to-a-random-secure-secret-key-32-chars

# Database Configuration (Optional - falls back to SQLite automatically if MySQL not available)
# DB_TYPE=mysql or DB_TYPE=sqlite
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1111
MYSQL_DATABASE=universal_qr

# Server Port (Render and cloud hosts automatically set PORT)
PORT=5000
